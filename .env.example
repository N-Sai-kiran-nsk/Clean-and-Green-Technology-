# Django Core Settings
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database Configuration (PostgreSQL / SQLite default)
DATABASE_URL=postgres://civic_user:civic_password@localhost:5432/civic_db

# Redis / WebSockets Configuration
REDIS_URL=redis://localhost:6379/0

# Cloud Storage Configuration (AWS S3 / Cloudflare R2)
USE_S3=False
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
AWS_S3_REGION_NAME=auto
AWS_S3_CUSTOM_DOMAIN=media.example.com
AWS_LOCATION=media

# Cloud Storage Alternative (Cloudinary)
USE_CLOUDINARY=False
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Error Tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Email Configuration
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=CivicPortal <noreply@civicportal.com>
