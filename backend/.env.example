# Django Settings Example
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Database Configuration
# Default Docker-friendly setup uses PostgreSQL
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=civic_db
DATABASE_USER=civic_user
DATABASE_PASSWORD=civic_password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Docker compose compatibility aliases
POSTGRES_DB=civic_db
POSTGRES_USER=civic_user
POSTGRES_PASSWORD=civic_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis / Channels
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# Optional local SQLite fallback
# DATABASE_ENGINE=django.db.backends.sqlite3
# DATABASE_NAME=db.sqlite3

# Error Tracking (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Email Configuration (optional)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# AWS S3 / Cloudflare R2 Configuration (optional for production)
USE_S3=False
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
AWS_S3_REGION_NAME=auto
AWS_S3_CUSTOM_DOMAIN=media.example.com
AWS_LOCATION=media

# Cloudinary Configuration (optional for production)
USE_CLOUDINARY=False
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
